# Optional: only if Apache serves public_html (static files) and Node runs separately on port 3001.
# Do NOT use this when cPanel Application Manager / Passenger already serves the Node app.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^api/(.*)$ http://127.0.0.1:3001/api/$1 [P,L]
</IfModule>
